# =============================================================================
# Local / secret configuration
# =============================================================================
local.properties
keystore.properties
tvhclient.properties
release-keystore.jks
*.jks
*.keystore

# Firebase config (environment specific)
/app/google-services.json

# Room exported schemas (generated)
/app/schemas/

# =============================================================================
# Build output
# =============================================================================
.gradle/
build/
/app/release/
captures/
.externalNativeBuild/
.cxx/
/out/

# Local scratch output (analysis reports, one-off tool dumps)
/tmp/

# Gradle GUI / task cache
gradle-app.setting
.gradletasknamecache

# Kotlin 2.x compiler caches
.kotlin/

# =============================================================================
# Logs and crash dumps
# =============================================================================
*.log
hs_err_pid*
*.hprof

# =============================================================================
# IntelliJ / Android Studio
# Project config is tracked; ignore only user-specific / high-churn files.
# =============================================================================
*.iml
*.iws
*.ipr
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/gradle.xml
.idea/dictionaries/
.idea/libraries/
.idea/caches/
.idea/modules/
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/appInsightsSettings.xml
.idea/markdown.xml
.idea/sonarlint/
.idea_modules/
.navigation/

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db

# =============================================================================
# Archives / binaries (keep the Gradle wrapper jar and any libs jars)
# =============================================================================
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/libs/*.jar
*.apk
*.aab
*.class
