<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Media3 cast mini controller. Replaces the legacy MiniControllerFragment, which has no
     Media3 equivalent. Tapping the bar opens the expanded controls; the button stops the cast. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cast_mini_controller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimary"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/cast_mini_controller_active"
        android:textColor="?attr/colorOnPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cast_mini_controller_stop"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cast_mini_controller_stop"
        android:textColor="?attr/colorOnPrimary" />
</LinearLayout>
