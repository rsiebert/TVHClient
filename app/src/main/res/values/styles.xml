<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!--<editor-fold desc="Font for title texts in various screens">-->
    <style name="TitleFont.Light" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/title_text_light</item>
    </style>

    <style name="TitleFont.Dark" parent="TitleFont.Light">
        <item name="android:textColor">@color/title_text_dark</item>
    </style>
    <!--</editor-fold>-->

    <!--<editor-fold desc="Font for subtitles in various screens">-->
    <style name="SubtitleFont.Light" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/subtitle_text_light</item>
    </style>

    <style name="SubtitleFont.Dark" parent="SubtitleFont.Light">
        <item name="android:textColor">@color/subtitle_text_dark</item>
    </style>
    <!--</editor-fold>-->

    <!--<editor-fold desc="Font for content in various screens">-->
    <style name="ContentFont.Light" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/content_text_light</item>
    </style>

    <style name="ContentFont.Dark" parent="ContentFont.Light">
        <item name="android:textColor">@color/content_text_dark</item>
    </style>
    <!--</editor-fold>-->

    <!--<editor-fold desc="Font for the program guide screen">-->
    <style name="ProgramGuideTitleFont.Light" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProgramGuideTitleFont.Dark" parent="ProgramGuideTitleFont.Light" />

    <style name="ProgramGuideContentFont.Light" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ProgramGuideContentFont.Dark" parent="ProgramGuideContentFont.Light" />
    <!--</editor-fold>-->

    <!--<editor-fold desc="Fonts for the changelog screen. The version is a section heading, the date a caption on the same row">-->
    <style name="ChangeLogVersionFont.Light" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/title_text_light</item>
    </style>

    <style name="ChangeLogVersionFont.Dark" parent="ChangeLogVersionFont.Light">
        <item name="android:textColor">@color/title_text_dark</item>
    </style>

    <style name="ChangeLogDateFont.Light" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/content_text_light</item>
    </style>

    <style name="ChangeLogDateFont.Dark" parent="ChangeLogDateFont.Light">
        <item name="android:textColor">@color/content_text_dark</item>
    </style>
    <!--</editor-fold>-->

    <!--<editor-fold desc="Font for section headings in the information screens">-->
    <style name="SectionHeaderFont.Light" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/title_text_light</item>
    </style>

    <style name="SectionHeaderFont.Dark" parent="SectionHeaderFont.Light">
        <item name="android:textColor">@color/title_text_dark</item>
    </style>
    <!--</editor-fold>-->

    <!--<editor-fold desc="Fonts for the internal player screen. The background is always dark">-->
