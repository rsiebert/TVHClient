<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        From Android 17 (API 37) all local network traffic is blocked unless the app holds this
        runtime permission. TVHClient only ever talks to a server on the local network (HTSP
        connection, Wake-on-LAN, Cast discovery), so without it nothing works. It is part of the
        NEARBY_DEVICES permission group and is requested at runtime before the first connection.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
        External storage access is legacy. From Android 10 (API 29) the app writes downloads to the
        public Downloads folder through scoped storage, and from Android 13 (API 33) reads are
        scoped through the media permissions, so each grant is capped at the last release that
        still needs it.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Media3's MediaSessionService runs as a mediaPlayback foreground service while casting. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name="org.tvheadend.tvhclient.MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="android.max_aspect"
            android:value="2.1" />
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="org.tvheadend.tvhclient.cast.CastOptionsProvider" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity android:name=".ui.features.settings.SettingsActivity" />
        <!-- Started explicitly by the Cast framework as the expanded controller activity, so it
             needs no intent filter of its own. -->
        <activity
            android:name=".ui.features.playback.external.ExpandedControlsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.features.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Searchable activity; the unused tvhclient:// deep link was removed. -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.default_searchable"
                android:value=".ui.features.MainActivity" />
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>
        <activity
            android:name=".ui.features.programs.ProgramDetailsActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />
        <activity android:name=".ui.features.playback.external.PlayRecordingActivity" />
        <activity android:name=".ui.features.playback.external.PlayChannelActivity" />
        <activity android:name=".ui.features.playback.external.CastChannelActivity" />
        <activity android:name=".ui.features.playback.external.CastRecordingActivity" />
        <activity android:name=".ui.features.playback.external.ShareRecordingActivity" />
        <activity android:name=".ui.features.dvr.recordings.download.DownloadRecordingActivity" />
        <activity
            android:name=".ui.features.playback.internal.PlaybackActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="smallestScreenSize|screenLayout|screenSize|orientation"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true" />

        <service
            android:name="org.tvheadend.tvhclient.service.ConnectionService"
            android:exported="false" />
        <service
            android:name="org.tvheadend.tvhclient.service.ConnectionIntentService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Media3 Cast: hosts the CastPlayer behind a MediaSession. Only the cast path uses it. -->
        <service
            android:name="org.tvheadend.tvhclient.cast.CastPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Lets the system Output Switcher discover and reroute cast media. -->
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" />

        <provider
            android:name=".ui.common.SuggestionProvider"
            android:authorities="org.tvheadend.tvhclient.ui.common.SuggestionProvider"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.tvheadend.tvhclient.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
