# Keep line endings consistent so they never show up as spurious modifications.
#
# Text files are stored with LF inside the repository and checked out with LF,
# no matter which platform the checkout happens on.
* text=auto eol=lf

# Windows batch scripts are LF as well; cmd.exe and PowerShell run them fine
# when they come straight from a git checkout.
*.bat text eol=lf
*.cmd text eol=lf

# Binary files must never be line-ending converted.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.ttf      binary
*.otf      binary
*.jar      binary
*.zip      binary
*.jks      binary
*.keystore binary
*.mp3      binary
*.mp4      binary
*.wav      binary
*.so       binary
*.xcf      binary
